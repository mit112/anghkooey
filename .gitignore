# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/xcode/
.swiftpm/configuration/
# Package.resolved is intentionally tracked for reproducible app builds (omit only for library targets)

# CocoaPods (not used, but guard against accidental addition)
Pods/
# Ignore user-specific data inside workspaces, not the workspace files themselves
**/*.xcworkspace/xcuserdata/
**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# CI
.ci-derived-data/

# Claude Code (local-only settings + cached state)
.claude/settings.local.json

# Other
*.log
*.lock
